# ==============================================================================
# EFIDP - Egypt Financial Intelligence Data Platform
# Environment Configuration Template (.env.example)
# Copy this file to .env and adjust values for your local machine.
# NEVER commit .env to Git.
# ==============================================================================

# ── Core Application ────────────────────────────────────────────────────────
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO
LOG_FORMAT=json

# ── PostgreSQL — Analytical Warehouse & Airflow Metastore ───────────────────
POSTGRES_USER=efidp_admin
POSTGRES_PASSWORD=efidp_dev_secret_change_in_prod
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=efidp_dw
# Docker Compose host port (5433 avoids conflict with any local Postgres)
POSTGRES_HOST_PORT=5433

# ── MinIO — S3-Compatible Lakehouse Object Store ────────────────────────────
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin_secret_dev
MINIO_ENDPOINT_URL=http://localhost:9000
MINIO_BRONZE_BUCKET=efidp-bronze
MINIO_SILVER_BUCKET=efidp-silver
MINIO_GOLD_BUCKET=efidp-gold
MINIO_QUARANTINE_BUCKET=efidp-quarantine
MINIO_SECURE=false
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# ── Apache Kafka (KRaft) — Event Streaming ──────────────────────────────────
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC_TRANSACTIONS_RAW=efidp.transactions.raw
KAFKA_TOPIC_DEADLETTER=efidp.transactions.deadletter
KAFKA_CONSUMER_GROUP=efidp-stream-workers
KAFKA_HOST_PORT=9092

# ── Redis — Cache & Near-Real-Time Counters ─────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
# Docker Compose host port (6380 avoids conflict with any local Redis)
REDIS_HOST_PORT=6380

# ── Apache Airflow ───────────────────────────────────────────────────────────
AIRFLOW_FERNET_KEY=46BKJoKcCNbryFtUmZoquC_nxIZsnRMHGpHtAmmUxbg=
AIRFLOW_SECRET_KEY=dev_airflow_secret_key_32_characters_min!
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=admin_password_dev
# Docker Compose host port (8085 avoids conflict with local servers on 8080)
AIRFLOW_HOST_PORT=8085

# ── FastAPI Serving Layer ────────────────────────────────────────────────────
API_SECRET_KEY=dev_jwt_secret_key_minimum_32_characters_for_hmac_sha256!
API_ALGORITHM=HS256
API_ACCESS_TOKEN_EXPIRE_MINUTES=60
# Docker Compose host port (8001 avoids conflict with local servers on 8000)
API_HOST_PORT=8001

# ── Prometheus & Grafana — Observability ────────────────────────────────────
PROMETHEUS_HOST_PORT=9090
GRAFANA_HOST_PORT=3001
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=grafana_dev_password
