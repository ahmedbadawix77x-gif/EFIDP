# ==============================================================================
# EFIDP - Egypt Financial Intelligence Data Platform
# Environment Configuration Template (.env.example)
# Copy this file to .env and adjust variables as required for local development.
# ==============================================================================

# Core Application Settings
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO
LOG_FORMAT=json

# PostgreSQL Analytical Warehouse & Metastore
POSTGRES_USER=efidp_admin
POSTGRES_PASSWORD=efidp_dev_secret_change_in_prod
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=efidp_dw
DATABASE_URL=postgresql+asyncpg://efidp_admin:efidp_dev_secret_change_in_prod@localhost:5432/efidp_dw

# MinIO (S3-Compatible Object Store)
MINIO_ENDPOINT_URL=http://localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin_secret_dev
MINIO_BRONZE_BUCKET=efidp-bronze
MINIO_SILVER_BUCKET=efidp-silver
MINIO_GOLD_BUCKET=efidp-gold
MINIO_SECURE=false

# Apache Kafka Event Streaming (KRaft Mode)
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC_TRANSACTIONS_RAW=efidp.transactions.raw
KAFKA_TOPIC_DEADLETTER=efidp.transactions.deadletter
KAFKA_CONSUMER_GROUP=efidp-stream-workers

# Redis Cache & Near-Real-Time Store
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

# Apache Airflow Orchestration
AIRFLOW_IMAGE_NAME=apache/airflow:2.8.1-python3.11
AIRFLOW_UID=50000
AIRFLOW_FERNET_KEY=46BKJoKcCNbryFtUmZoquC_nxIZsnRMHGpHtAmmUxbg=
AIRFLOW_SECRET_KEY=dev_airflow_secret_key_32_characters_min!

# API Serving Layer & Security
API_HOST=0.0.0.0
API_PORT=8000
API_SECRET_KEY=dev_jwt_secret_key_minimum_32_characters_for_hmac_sha256!
API_ALGORITHM=HS256
API_ACCESS_TOKEN_EXPIRE_MINUTES=60
